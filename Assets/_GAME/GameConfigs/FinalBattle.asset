  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 8cec438872f9aaf47868ed9d3c2e5250, type: 3}
  m_Name: FinalBattle
  m_EditorClassIdentifier: 
  listData:
  - characterUI: {fileID: 21300000, guid: bb53fa654d5ca8c40a93f8bd3408772b, type: 3}
    content: You have come. I have waited for this moment for a long time.
  - characterUI: {fileID: 21300000, guid: 4c05954cb4242394196d65490ee64f4a, type: 3}
    content: "I didn\u2019t come to talk. I came to end you."
  - characterUI: {fileID: 21300000, guid: bb53fa654d5ca8c40a93f8bd3408772b, type: 3}
    content: Good. A blade guided by hatred is sharp enough to kill me.
  - characterUI: {fileID: 21300000, guid: 4c05954cb4242394196d65490ee64f4a, type: 3}
    content: Not hatred. Justice for those who have fallen.
  - characterUI: {fileID: 21300000, guid: bb53fa654d5ca8c40a93f8bd3408772b, type: 3}
    content: Then step forward. Only the one who survives has the right to speak
      of justice.
  - characterUI: {fileID: 21300000, guid: 4c05954cb4242394196d65490ee64f4a, type: 3}
    content: I will be that one. And you will disappear here.
