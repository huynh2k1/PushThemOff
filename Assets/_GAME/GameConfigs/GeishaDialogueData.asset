  m_Script: {fileID: 11500000, guid: 8cec438872f9aaf47868ed9d3c2e5250, type: 3}
  m_Name: GeishaDialogueData
  m_EditorClassIdentifier: 
  listData:
  - characterUI: {fileID: 21300000, guid: 54bbf29e908ffc04d8c870254b8c42fc, type: 3}
    content: "Finally\u2026 you\u2019re here. Thank you for saving me."
  - characterUI: {fileID: 21300000, guid: 4c05954cb4242394196d65490ee64f4a, type: 3}
    content: Are you okay? We need to get out of here.
  - characterUI: {fileID: 21300000, guid: 54bbf29e908ffc04d8c870254b8c42fc, type: 3}
    content: "Wait\u2026 the door ahead is extremely dangerous. Many people never
      came back."
  - characterUI: {fileID: 21300000, guid: 54bbf29e908ffc04d8c870254b8c42fc, type: 3}
    content: Do you really want to go on?
  - characterUI: {fileID: 21300000, guid: 4c05954cb4242394196d65490ee64f4a, type: 3}
    content: "I\u2019ve come this far. Open the door. I\u2019ll handle the rest."
